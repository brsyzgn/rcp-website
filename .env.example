# Site
NEXT_PUBLIC_SITE_URL=https://www.yasamelektronik.com

# =============================================================================
# Resend kurulum (ücretsiz)
# 1) https://resend.com/signup
# 2) Domains → Add Domain → yasamelektronik.com
# 3) DNS panelinize Resend’in verdiği kayıtları ekleyin (SPF + DKIM)
# 4) Resend’de Verify
# 5) API Keys → Create → Sending access → key’i aşağıya yapıştırın
# =============================================================================

RESEND_API_KEY=

# Alıcı
CONTACT_TO_EMAIL=info@yasamelektronik.com

# Gönderen (domain doğrulandıktan sonra)
CONTACT_FROM_EMAIL=Yaşam Elektronik <noreply@yasamelektronik.com>

# Domain henüz doğrulanmadıysa geçici test (yalnızca Resend hesap e-postanıza gider):
# CONTACT_FROM_EMAIL=Yaşam Elektronik <onboarding@resend.dev>
